# Copy this file to .env in the project root and edit the values.
# Existing shell environment variables override these settings.
OPENAI_API_KEY=your-api-key
AGENT_MODEL=your-model-id

# Optional OpenAI-compatible API base URL, including /v1 when required.
# Leave blank for the standard OpenAI endpoint.
OPENAI_BASE_URL=

# Example local endpoint: http://localhost:8000/v1
# For a local server that requires no key, set OPENAI_API_KEY=local.
# Your endpoint/model must support tool calling with ChatOpenAI.

# Optional cap on requests per minute across chat and embeddings (blank = no cap).
# NVIDIA's free tier allows about 40 per minute per key; set 40 to stay under it.
API_REQUESTS_PER_MINUTE=

# Mem0 extraction model; blank values inherit the agent's configuration.
MEMORY_ENABLED=true
MEMORY_MODEL=
MEMORY_API_KEY=
MEMORY_BASE_URL=
# How memories reach the agent: auto (relevant memories are added before every model
# call; the default), tool (it calls recall) or both. Compare them with evals/memory_recall.py.
MEMORY_RECALL=auto

# Embeddings for both Mem0 and RAG. They may use a different provider.
# Blank key inherits OPENAI_API_KEY; blank endpoint uses OpenAI's standard API.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Set this to the embedding model's actual output size for Mem0's Qdrant collection.
EMBEDDING_DIMENSIONS=1536
# Texts per embedding request. NVIDIA's hosted nemotron-3.5-embed-8b rejects multi-text
# requests with a 500, so set 1 there (the client also adapts on its own).
EMBEDDING_BATCH_SIZE=16
# NVIDIA example (set model, endpoint and dimensions together):
# EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b
# EMBEDDING_PROVIDER=nvidia
# EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
# EMBEDDING_DIMENSIONS=4096
RAG_ENABLED=true

# Tools the agent must not have, comma-separated (e.g. execute,delete). They are hidden
# from the model and refused if called. ls, read_file and write_todos can't be turned off.
DISABLED_TOOLS=

# Extra folders of subagent files (Claude Code format), e.g. your ~/.claude/agents.
# Separate several with ; on Windows or : elsewhere. demo_workspace/agents/ is always read.
# Use forward slashes (C:/Users/me/.claude/agents) or no quotes; quoted backslashes are mangled.
AGENT_DIRS=
# Most model calls one subagent run may make (an agent's maxTurns can lower it).
SUBAGENT_MAX_CALLS=25
# How many subagents may run at the same time (they share the request rate limit).
SUBAGENT_MAX_PARALLEL=3
# Plans with review: failed reviews per step before you are asked to retry, skip or stop,
# and the model calls one plan may use before you are asked to continue or wrap up.
PLAN_MAX_ATTEMPTS=2
ORCHESTRATION_MAX_CALLS=150

# none = local files without command execution; daytona = remote sandbox;
# openshell = local sandbox governed by policy.yaml (needs the OpenShell CLI and gateway).
SANDBOX_PROVIDER=none
DAYTONA_API_KEY=
# Optional: reuse a particular existing, running sandbox.
# Otherwise a created sandbox's ID is retained in data/daytona_sandbox_id.txt.
DAYTONA_SANDBOX_ID=

# OpenShell: build the image and create the sandbox first (see README):
#   docker build -t deep-agents-demo-sandbox:0.1 sandbox/
#   openshell sandbox create --name deep-agents-demo --from deep-agents-demo-sandbox:0.1 --policy policy.yaml --detach
OPENSHELL_SANDBOX_NAME=deep-agents-demo
OPENSHELL_WORKSPACE=default
OPENSHELL_WORKDIR=/sandbox
# Windows with the gateway in WSL: read the CLI's gateway config from Ubuntu.
# XDG_CONFIG_HOME=\\wsl.localhost\Ubuntu-24.04\home\<your-ubuntu-user>\.config
