# Copy this file to .env in the project root and edit the values.
# Existing shell environment variables override these settings.
OPENAI_API_KEY=your-api-key
AGENT_MODEL=your-model-id

# Optional OpenAI-compatible API base URL, including /v1 when required.
# Leave blank for the standard OpenAI endpoint.
OPENAI_BASE_URL=

# Example local endpoint: http://localhost:8000/v1
# For a local server that requires no key, set OPENAI_API_KEY=local.
# Your endpoint/model must support tool calling with ChatOpenAI.

# Mem0 extraction model; blank values inherit the agent's configuration.
MEMORY_ENABLED=true
MEMORY_MODEL=
MEMORY_API_KEY=
MEMORY_BASE_URL=

# Embeddings for both Mem0 and RAG. They may use a different provider.
# Blank key inherits OPENAI_API_KEY; blank endpoint uses OpenAI's standard API.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Set this to the embedding model's actual output size for Mem0's Qdrant collection.
EMBEDDING_DIMENSIONS=1536
# NVIDIA example (set model, endpoint and dimensions together):
# EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b
# EMBEDDING_PROVIDER=nvidia
# EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
# EMBEDDING_DIMENSIONS=4096
RAG_ENABLED=true

# none = local files without command execution; daytona = remote sandbox.
SANDBOX_PROVIDER=none
DAYTONA_API_KEY=
# Optional: reuse a particular existing, running sandbox.
# Otherwise a created sandbox's ID is retained in data/daytona_sandbox_id.txt.
DAYTONA_SANDBOX_ID=
